# Copy to `.env.local` (gitignored) and fill in real values.

# --- Frontend → own API ---
VITE_OWN_API_URL=http://localhost:3001

# Optional realtime transport: polling (default) | sse
# VITE_REALTIME_TRANSPORT=polling

# --- Shared / server (prefer server/.env for secrets) ---
# Matches docker-compose.yml defaults when using local Postgres:
DATABASE_URL=postgresql://travvin:travvin@localhost:5432/travvin
PORT=3001

# See server/.env.example for JWT, Google OAuth, Calendar, Gemini, uploads.
