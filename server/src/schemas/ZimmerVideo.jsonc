{
  "type": "object",
  "name": "ZimmerVideo",
  "title": "\u05e1\u05e8\u05d8\u05d5\u05df \u05e6\u05d9\u05de\u05e8",
  "properties": {
    "video_url": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d5\u05d9\u05d3\u05d0\u05d5"
    },
    "owner_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e2\u05dc\u05d9\u05dd"
    },
    "owner_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d1\u05e2\u05dc\u05d9\u05dd (cache)"
    },
    "owner_avatar_url": {
      "type": "string",
      "title": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d1\u05e2\u05dc\u05d9\u05dd (cache)"
    },
    "zimmer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e6\u05d9\u05de\u05e8"
    },
    "zimmer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e6\u05d9\u05de\u05e8 (cache)"
    },
    "caption": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "likes_count": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05dc\u05d9\u05d9\u05e7\u05d9\u05dd",
      "default": 0
    },
    "hidden": {
      "type": "boolean",
      "title": "\u05de\u05d5\u05e1\u05ea\u05e8",
      "default": false
    },
    "comments_hidden": {
      "type": "boolean",
      "title": "\u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05de\u05d5\u05e1\u05ea\u05e8\u05d5\u05ea",
      "default": false
    },
    "proposal_status": {
      "type": "string",
      "enum": [
        "\u05e4\u05e2\u05d9\u05dc",
        "\u05d4\u05e6\u05e2\u05d4",
        "\u05e0\u05d3\u05d7\u05ea\u05d4"
      ],
      "default": "\u05e4\u05e2\u05d9\u05dc",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e6\u05e2\u05d4"
    },
    "proposed_by_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e6\u05d9\u05e2 (\u05d0\u05d3\u05de\u05d9\u05df)"
    },
    "proposed_by_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05e6\u05d9\u05e2 (cache)"
    },
    "proposal_note": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05ea \u05d0\u05d3\u05de\u05d9\u05df \u05dc\u05d4\u05e6\u05e2\u05d4"
    },
    "proposal_decided_at": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d7\u05dc\u05d8\u05ea \u05d1\u05e2\u05dc\u05d9\u05dd"
    }
  },
  "required": [
    "video_url",
    "owner_id",
    "zimmer_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.hidden": false
            },
            {
              "data.proposal_status": {
                "$ne": "\u05d4\u05e6\u05e2\u05d4"
              }
            },
            {
              "data.proposal_status": {
                "$ne": "\u05e0\u05d3\u05d7\u05ea\u05d4"
              }
            }
          ]
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}