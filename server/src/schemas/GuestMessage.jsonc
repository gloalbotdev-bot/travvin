{
  "type": "object",
  "title": "\u05d4\u05d5\u05d3\u05e2\u05ea \u05d0\u05d5\u05e8\u05d7",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7"
    },
    "customer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "booking_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "zimmer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e6\u05d9\u05de\u05e8"
    },
    "zimmer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e6\u05d9\u05de\u05e8"
    },
    "owner_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e2\u05dc \u05de\u05ea\u05d7\u05dd"
    },
    "category": {
      "type": "string",
      "enum": [
        "search_start",
        "booking_confirmation",
        "pre_checkin",
        "checkin_day",
        "checkin",
        "post_checkin",
        "pre_checkout",
        "morning_checkout",
        "checkout",
        "review_reminder",
        "ai_recommendations",
        "custom"
      ],
      "default": "custom",
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea"
    },
    "body": {
      "type": "string",
      "title": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "metadata": {
      "type": "object",
      "title": "\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd (\u05db\u05ea\u05d5\u05d1\u05ea, \u05e0\u05d9\u05d5\u05d5\u05d8, \u05d4\u05de\u05dc\u05e6\u05d5\u05ea)",
      "properties": {
        "address": {
          "type": "string"
        },
        "nav_link": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "key_location": {
          "type": "string"
        },
        "entry_code": {
          "type": "string"
        },
        "phones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "title": "\u05e2\u05e8\u05d5\u05e6\u05d9 \u05e9\u05dc\u05d9\u05d7\u05d4",
      "items": {
        "type": "string",
        "enum": [
          "app",
          "whatsapp"
        ]
      },
      "default": [
        "app"
      ]
    },
    "delivery_status": {
      "type": "object",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e9\u05dc\u05d5\u05d7 \u05dc\u05e2\u05e8\u05d5\u05e6\u05d9\u05dd",
      "properties": {
        "app": {
          "type": "string",
          "enum": [
            "pending",
            "sent",
            "failed"
          ]
        },
        "whatsapp": {
          "type": "string",
          "enum": [
            "skipped",
            "sent",
            "failed",
            "not_configured"
          ]
        },
        "whatsapp_error": {
          "type": "string"
        }
      }
    },
    "read": {
      "type": "boolean",
      "title": "\u05e0\u05e7\u05e8\u05d0\u05d4",
      "default": false
    }
  },
  "required": [
    "customer_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "GuestMessage"
}