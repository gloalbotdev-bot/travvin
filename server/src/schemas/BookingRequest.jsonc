{
  "type": "object",
  "properties": {
    "zimmer_id": {
      "type": "string",
      "title": "מזהה צימר"
    },
    "zimmer_name": {
      "type": "string",
      "title": "שם הצימר"
    },
    "owner_id": {
      "type": "string",
      "title": "מזהה בעל המתחם"
    },
    "guest_name": {
      "type": "string",
      "title": "שם הלקוח"
    },
    "guest_phone": {
      "type": "string",
      "title": "טלפון"
    },
    "check_in": {
      "type": "string",
      "format": "date",
      "title": "תאריך כניסה"
    },
    "check_out": {
      "type": "string",
      "format": "date",
      "title": "תאריך יציאה"
    },
    "num_guests": {
      "type": "number",
      "title": "מספר אורחים"
    },
    "num_adults": {
      "type": "number",
      "title": "מספר מבוגרים"
    },
    "num_children": {
      "type": "number",
      "title": "מספר ילדים"
    },
    "status": {
      "type": "string",
      "enum": [
        "ממתינה",
        "אושרה",
        "נדחתה",
        "חסום"
      ],
      "default": "ממתינה",
      "title": "סטטוס"
    },
    "is_block": {
      "type": "boolean",
      "title": "חסימת תאריך (לא הזמנה)",
      "default": false
    },
    "block_reason": {
      "type": "string",
      "title": "סיבת חסימה"
    },
    "notes": {
      "type": "string",
      "title": "הערות"
    },
    "total_price": {
      "type": "number",
      "title": "סך תשלום מחושב"
    },
    "calendar_event_id": {
      "type": "string",
      "title": "מזהה אירוע ביומן"
    },
    "deletion_request_reason": {
      "type": "string",
      "title": "סיבת בקשת מחיקה (בעל מתחם → אדמין)"
    },
    "deletion_request_at": {
      "type": "string",
      "title": "תאריך בקשת מחיקה"
    },
    "cancel_request_reason": {
      "type": "string",
      "title": "סיבת בקשת ביטול (לקוח → בעל מתחם)"
    },
    "cancel_request_at": {
      "type": "string",
      "title": "תאריך בקשת ביטול"
    },
    "checked_out": {
      "type": "boolean",
      "title": "בוצע צ'ק-אאוט",
      "default": false
    },
    "checked_out_at": {
      "type": "string",
      "title": "תאריך ביצוע צ'ק-אאוט"
    },
    "checkout_by": {
      "type": "string",
      "enum": [
        "customer",
        "owner",
        "admin"
      ],
      "title": "מי ביצע את הצ'ק-אאוט"
    },
    "checkout_photos": {
      "type": "array",
      "title": "תמונות צ'ק-אאוט",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "checkout_notes": {
      "type": "string",
      "title": "הערות צ'ק-אאוט"
    },
    "checkout_rating": {
      "type": "number",
      "title": "דירוג חופשה (צ'ק-אאוט)"
    },
    "checkout_report": {
      "type": "string",
      "title": "דיווח תקלה/נזק בצ'ק-אאוט"
    },
    "source_video_id": {
      "type": "string",
      "title": "מזהה סרטון מקור (Discover)"
    }
  },
  "required": [
    "zimmer_id",
    "guest_name",
    "guest_phone",
    "check_in",
    "check_out"
  ],
  "name": "BookingRequest",
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "authenticated": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
