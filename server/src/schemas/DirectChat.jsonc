{
  "type": "object",
  "title": "\u05e6'\u05d0\u05d8 \u05d9\u05e9\u05d9\u05e8",
  "properties": {
    "zimmer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e6\u05d9\u05de\u05e8"
    },
    "zimmer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e6\u05d9\u05de\u05e8"
    },
    "customer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "customer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "owner_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e2\u05dc \u05d4\u05e6\u05d9\u05de\u05e8"
    },
    "owner_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d1\u05e2\u05dc \u05d4\u05e6\u05d9\u05de\u05e8"
    },
    "booking_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d6\u05de\u05e0\u05d4 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "messages": {
      "type": "array",
      "title": "\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "owner"
            ]
          },
          "content": {
            "type": "string"
          },
          "time": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "zimmer_id",
    "customer_id",
    "owner_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "DirectChat"
}