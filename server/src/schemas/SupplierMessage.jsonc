{
  "type": "object",
  "title": "\u05d4\u05d5\u05d3\u05e2\u05d4 \u05dc\u05e1\u05e4\u05e7 (B2B)",
  "properties": {
    "owner_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd"
    },
    "contact_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "contact_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e1\u05e4\u05e7"
    },
    "contact_phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d4\u05e1\u05e4\u05e7"
    },
    "category": {
      "type": "string",
      "enum": [
        "order",
        "reminder",
        "custom"
      ],
      "default": "custom",
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea"
    },
    "body": {
      "type": "string",
      "title": "\u05ea\u05d5\u05db\u05df"
    },
    "delivery_status": {
      "type": "object",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e9\u05dc\u05d5\u05d7",
      "properties": {
        "whatsapp": {
          "type": "string",
          "enum": [
            "sent",
            "failed",
            "not_configured"
          ]
        },
        "whatsapp_error": {
          "type": "string"
        }
      }
    },
    "sent_at": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05dc\u05d9\u05d7\u05d4"
    }
  },
  "required": [
    "owner_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "SupplierMessage"
}