{
  "type": "object",
  "properties": {
    "zimmer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e6\u05d9\u05de\u05e8"
    },
    "zimmer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e6\u05d9\u05de\u05e8"
    },
    "owner_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e2\u05dc \u05de\u05ea\u05d7\u05dd"
    },
    "question": {
      "type": "string",
      "title": "\u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "session_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d9\u05d7\u05d4"
    },
    "customer_search_summary": {
      "type": "string",
      "title": "\u05e1\u05d9\u05db\u05d5\u05dd \u05d7\u05d9\u05e4\u05d5\u05e9 \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "customer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05de\u05de\u05ea\u05d9\u05e0\u05d4",
        "\u05e0\u05e2\u05e0\u05ea\u05d4",
        "\u05e0\u05d3\u05d7\u05ea\u05d4"
      ],
      "default": "\u05de\u05de\u05ea\u05d9\u05e0\u05d4",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "owner_answer": {
      "type": "string",
      "title": "\u05ea\u05e9\u05d5\u05d1\u05ea \u05d4\u05d1\u05e2\u05dc\u05d9\u05dd"
    },
    "answered_by": {
      "type": "string",
      "enum": ["owner", "ai", "admin"],
      "title": "\u05de\u05d9 \u05e2\u05e0\u05d4"
    },
    "save_to_knowledge": {
      "type": "boolean",
      "title": "\u05e9\u05de\u05d5\u05e8 \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05d9\u05d3\u05e2",
      "default": false
    },
    "answered_at": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05de\u05e2\u05e0\u05d4"
    }
  },
  "required": [
    "zimmer_id",
    "owner_id",
    "question"
  ],
  "name": "UnansweredQuestion",
  "rls": {
    "read": {
      "$or": [
        { "data.owner_id": "{{user.id}}" },
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        { "user_condition": { "authenticated": true } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.owner_id": "{{user.id}}" },
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.owner_id": "{{user.id}}" },
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}