{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05ea\u05de\u05e9"
    },
    "user_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "user_email": {
      "type": "string",
      "format": "email",
      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "vacation_preferences": {
      "type": "string",
      "title": "\u05de\u05d4 \u05d0\u05e0\u05d9 \u05d0\u05d5\u05d4\u05d1 \u05d1\u05e0\u05d5\u05e4\u05e9"
    },
    "preferred_regions": {
      "type": "string",
      "title": "\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05de\u05d5\u05e2\u05d3\u05e4\u05d9\u05dd"
    },
    "num_guests_usual": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d0\u05d5\u05e8\u05d7\u05d9\u05dd \u05e8\u05d2\u05d9\u05dc"
    },
    "interests_tags": {
      "type": "array",
      "title": "\u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05e0\u05dc\u05de\u05d3\u05d9\u05dd (AI)",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "interests_updated_at": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05d3\u05db\u05d5\u05df \u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df"
    }
  },
  "required": [
    "user_id"
  ],
  "name": "CustomerProfile",
  "rls": {
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}