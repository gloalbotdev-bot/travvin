# Server-only env. Copy to `server/.env` (gitignored). Do not commit secrets.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

PORT=3001
FRONTEND_URL=http://localhost:5173

# Auth (M5) — required when VITE_BACKEND_AUTH=own
JWT_SECRET=generate-a-long-random-string-here
# JWT_EXPIRES_IN=7d

# Google OAuth — required for "Sign in with Google"
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Google Calendar OAuth (M8) — separate redirect; may reuse login client id/secret
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/connectors/google-calendar/oauth/callback
# 32-byte key: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Dev-only override (optional)
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_CALENDAR_DEV_OWNER_ID=
# GOOGLE_CALENDAR_ID=
# CALENDAR_CRON_DISABLED=1

APP_ID=travvin

# LLM (M10) — Gemini only (decisions.md §5). Key stays server-side.
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# LLM_MOCK=1

# File uploads (M11) — local disk + static /uploads (S3 later via STORAGE_DRIVER)
PUBLIC_API_URL=http://localhost:3001
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./uploads
# UPLOAD_MAX_BYTES=10485760

# Optional SMTP (OTP / password reset emails). Without SMTP, codes print to server console.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
