  "whatsapp_greeting": "",
  "line_greeting": "",
  "telegram_greeting": "\u05e9\u05dc\u05d5\u05dd! \u05d0\u05e0\u05d9 \u05d4\u05e2\u05d5\u05d6\u05e8 \u05d4\u05d0\u05d9\u05e9\u05d9 \u05e9\u05dc\u05da \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05e6\u05d9\u05de\u05e8\u05d9\u05dd \ud83c\udfe1\n\n\u05de\u05e6\u05d1 \u05de\u05d9\u05d3\u05e2: \u05d0\u05e9\u05d9\u05d1 \u05e2\u05dc \u05e9\u05d0\u05dc\u05d5\u05ea \u05d5\u05d0\u05e6\u05d9\u05d2 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd.\n\u05de\u05e6\u05d1 \u05e2\u05e8\u05d9\u05db\u05d4: \u05d0\u05d5\u05db\u05dc \u05dc\u05d1\u05e6\u05e2 \u05d1\u05e9\u05d1\u05d9\u05dc\u05da \u05db\u05dc \u05e4\u05e2\u05d5\u05dc\u05d4 \u2014 \u05d4\u05d6\u05de\u05e0\u05d5\u05ea, \u05e2\u05d3\u05db\u05d5\u05df \u05de\u05d7\u05d9\u05e8\u05d9\u05dd, \u05de\u05e2\u05e0\u05d4 \u05dc\u05dc\u05e7\u05d5\u05d7\u05d5\u05ea \u05d5\u05e2\u05d5\u05d3.\n\n\u05de\u05d4 \u05ea\u05e8\u05e6\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea?",
