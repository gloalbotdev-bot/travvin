    {
      "function_name": "addBookingToCalendar",
      "description": "\u05de\u05d5\u05e1\u05d9\u05e3 \u05d4\u05d6\u05de\u05e0\u05d4 \u05db\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d1\u05d9\u05d5\u05de\u05df Google \u05e9\u05dc \u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd. \u05e7\u05e8\u05d0 \u05e2\u05dd booking_id \u05dc\u05d0\u05d7\u05e8 \u05d9\u05e6\u05d9\u05e8\u05ea/\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d6\u05de\u05e0\u05d4."
    },
    {
      "function_name": "syncGoogleCalendar",
      "description": "\u05de\u05e1\u05e0\u05db\u05e8\u05df \u05d9\u05d3\u05e0\u05d9\u05ea \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05de\u05d9\u05d5\u05de\u05df Google \u05dc\u05d4\u05d6\u05de\u05e0\u05d5\u05ea \u05d1\u05de\u05e2\u05e8\u05db\u05ea. \u05e7\u05e8\u05d0 \u05e8\u05e7 \u05db\u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05d1\u05e7\u05e9 \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d9\u05d3\u05e0\u05d9."
    },
    {
      "function_name": "pushInAppNotification",
      "description": "\u05e9\u05d5\u05dc\u05d7 \u05d4\u05ea\u05e8\u05d0\u05d4 \u05d1\u05ea\u05d5\u05da \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05dc\u05de\u05e9\u05ea\u05de\u05e9. \u05e7\u05e8\u05d0 \u05e8\u05e7 \u05db\u05e9\u05d9\u05e9 \u05e6\u05d5\u05e8\u05da \u05de\u05e4\u05d5\u05e8\u05e9 \u05dc\u05d4\u05d5\u05d3\u05d9\u05e2 \u05dc\u05de\u05e9\u05ea\u05de\u05e9."
    }
  ],
