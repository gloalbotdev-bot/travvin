{
  "name": "Question Answered Notify Customer",
  "description": "\u05e9\u05d5\u05dc\u05d7 \u05e4\u05d5\u05e9 \u05d1\u05ea\u05d5\u05da \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05dc\u05dc\u05e7\u05d5\u05d7 \u05db\u05e9\u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd \u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc \u05e9\u05d0\u05dc\u05ea\u05d5",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "UnansweredQuestion",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"\u05e0\u05e2\u05e0\u05ea\u05d4\" and .trigger.old_data.status != \"\u05e0\u05e2\u05e0\u05ea\u05d4\" and (.trigger.data.created_by_id // \"\") != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "question_answered_notify_customer",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushInAppNotification",
            "args": {
              "audience": "customer",
              "target_user_ids": "${ [ .trigger.data.created_by_id ] }",
              "category": "\u05d4\u05d5\u05d3\u05e2\u05d4",
              "title": "\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d7\u05d3\u05e9\u05d4 \u05de\u05d1\u05e2\u05dc \u05d4\u05e6\u05d9\u05de\u05e8",
              "body": "\u05e7\u05d9\u05d1\u05dc\u05ea \u05ea\u05e9\u05d5\u05d1\u05d4 \u05de\u05d1\u05e2\u05dc ${ .trigger.data.zimmer_name } \u05dc\u05e9\u05d0\u05dc\u05ea\u05da. \u05dc\u05d7\u05e5 \u05dc\u05e7\u05e8\u05d9\u05d0\u05ea \u05d4\u05ea\u05e9\u05d5\u05d1\u05d4.",
              "action_type": "open_answer",
              "action_entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e9\u05dc\u05d7 \u05e4\u05d5\u05e9 \u05dc\u05dc\u05e7\u05d5\u05d7"
          }
        }
      }
    ]
  }
}