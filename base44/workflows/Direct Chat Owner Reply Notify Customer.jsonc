{
  "name": "Direct Chat Owner Reply Notify Customer",
  "description": "\u05e9\u05d5\u05dc\u05d7 \u05e4\u05d5\u05e9 \u05dc\u05dc\u05e7\u05d5\u05d7 \u05db\u05e9\u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd \u05de\u05e9\u05d9\u05d1 \u05dc\u05d5 \u05d1\u05e6'\u05d0\u05d8 \u05d4\u05d9\u05e9\u05d9\u05e8",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "DirectChat",
      "events": [
        "update"
      ]
    },
    "condition": "${ ((.trigger.data.messages // []) | length) > ((.trigger.old_data.messages // []) | length) and (.trigger.data.messages // [])[-1].role == \"owner\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "direct_chat_owner_reply_notify_customer",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushInAppNotification",
            "args": {
              "audience": "customer",
              "target_user_ids": "${ [ .trigger.data.customer_id ] }",
              "category": "\u05d4\u05d5\u05d3\u05e2\u05d4",
              "title": "\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d7\u05d3\u05e9\u05d4 \u05de\u05d1\u05e2\u05dc \u05d4\u05e6\u05d9\u05de\u05e8 \u05d1\u05e6'\u05d0\u05d8",
              "body": "${ .trigger.data.owner_name } \u05e2\u05e0\u05d4 \u05dc\u05da \u05d1\u05e6'\u05d0\u05d8 \u05e2\u05dc \"${ .trigger.data.zimmer_name }\": ${ (.trigger.data.messages // [])[-1].content }",
              "action_type": "open_chat",
              "action_entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e9\u05dc\u05d7 \u05e4\u05d5\u05e9 \u05dc\u05dc\u05e7\u05d5\u05d7"
          }
        }
      }
    ]
  }
}