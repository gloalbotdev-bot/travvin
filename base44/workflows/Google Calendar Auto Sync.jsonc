{
  "name": "Google Calendar Auto Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_calendar_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "auto_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGoogleCalendar",
            "args": {
              "_from_workflow": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9",
            "description": "\u05db\u05dc 30 \u05d3\u05e7\u05d5\u05ea, \u05d0\u05dd \u05de\u05d5\u05e4\u05e2\u05dc \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea"
          }
        }
      }
    ]
  },
  "description": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05d9\u05d5\u05de\u05df Google \u05db\u05dc 30 \u05d3\u05e7\u05d5\u05ea, \u05e8\u05e7 \u05db\u05e9\u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd \u05d4\u05e4\u05e2\u05d9\u05dc \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}