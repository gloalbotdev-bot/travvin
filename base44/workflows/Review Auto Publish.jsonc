{
  "name": "Review Auto Publish",
  "description": "\u05e4\u05e8\u05e1\u05d5\u05dd \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05d1\u05d9\u05e7\u05d5\u05e8\u05d5\u05ea: \u05d3\u05d9\u05e8\u05d5\u05d2 4-5 \u05de\u05ea\u05e4\u05e8\u05e1\u05dd \u05ea\u05d5\u05da 12 \u05e9\u05e2\u05d5\u05ea (\u05d0\u05dc\u05d0 \u05d0\u05dd \u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd \u05e2\u05e8\u05e2\u05e8), \u05d3\u05d9\u05e8\u05d5\u05d2 1-3 \u05de\u05ea\u05e4\u05e8\u05e1\u05dd \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05ea\u05d5\u05da 48 \u05e9\u05e2\u05d5\u05ea \u05d0\u05dd \u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd \u05dc\u05d0 \u05e4\u05e2\u05dc (\u05e4\u05e8\u05e1\u05d5\u05dd/\u05d4\u05e6\u05e2\u05ea \u05e4\u05e9\u05e8\u05d4)",
  "trigger": {
    "condition": "${ .trigger.data.status == \"pending_publish\" or .trigger.data.status == \"pending_owner\" }",
    "config": {
      "trigger_type": "entity",
      "entity_name": "Review",
      "events": [
        "create"
      ]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "review_auto_publish",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "route": {
          "switch": [
            {
              "when": "${ .trigger.data.status == \"pending_publish\" }",
              "then": "wait_high"
            },
            {
              "when": "${ .trigger.data.status == \"pending_owner\" }",
              "then": "wait_low"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "\u05de\u05d9\u05d5\u05df \u05dc\u05e4\u05d9 \u05d3\u05d9\u05e8\u05d5\u05d2",
            "description": "4-5 \u05d0\u05d5 1-3"
          }
        }
      },
      {
        "wait_high": {
          "wait": "PT12H",
          "then": "finalize",
          "x-base44": {
            "title": "\u05d4\u05de\u05ea\u05e0\u05d4 12 \u05e9\u05e2\u05d5\u05ea",
            "description": "\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d7\u05d9\u05d5\u05d1\u05d9\u05ea"
          }
        }
      },
      {
        "wait_low": {
          "wait": "PT48H",
          "then": "finalize",
          "x-base44": {
            "title": "\u05d4\u05de\u05ea\u05e0\u05d4 48 \u05e9\u05e2\u05d5\u05ea",
            "description": "\u05e4\u05e7\u05d9\u05e2\u05ea \u05d6\u05de\u05df \u05d1\u05e2\u05dc\u05d9\u05dd"
          }
        }
      },
      {
        "finalize": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "finalizeReviewAutoPublish",
            "args": {
              "review_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e4\u05e8\u05e1\u05d5\u05dd \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9",
            "description": "\u05e8\u05e7 \u05d0\u05dd \u05e2\u05d3\u05d9\u05d9\u05df \u05d1\u05d4\u05de\u05ea\u05e0\u05d4"
          }
        }
      }
    ]
  }
}