{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_calendar_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_calendar": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGoogleCalendar",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e1\u05e0\u05db\u05e8\u05df \u05d9\u05d5\u05de\u05df Google",
            "description": "\u05de\u05e2\u05d3\u05db\u05df \u05d4\u05d6\u05de\u05e0\u05d5\u05ea \u05dc\u05e4\u05d9 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05d9\u05d5\u05de\u05df"
          }
        }
      }
    ]
  },
  "name": "Google Calendar Sync",
  "description": "\u05de\u05e1\u05e0\u05db\u05e8\u05df \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05de\u05d9\u05d5\u05de\u05df Google \u05dc\u05d4\u05d6\u05de\u05e0\u05d5\u05ea \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "connector",
      "events": [
        "events"
      ],
      "integration_type": "googlecalendar",
      "resource_id": "primary"
    }
  }
}