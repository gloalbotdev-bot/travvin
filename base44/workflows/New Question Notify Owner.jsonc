{
  "name": "New Question Notify Owner",
  "description": "\u05e9\u05d5\u05dc\u05d7 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05d1\u05ea\u05d5\u05da \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05dc\u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd \u05db\u05e9\u05dc\u05e7\u05d5\u05d7 \u05e9\u05d5\u05d0\u05dc \u05e9\u05d0\u05dc\u05d4 \u05d7\u05d3\u05e9\u05d4",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "UnansweredQuestion",
      "events": [
        "create"
      ]
    },
    "condition": "${ (.trigger.data.owner_id // \"\") != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_question_notify_owner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushInAppNotification",
            "args": {
              "audience": "owner",
              "target_user_ids": "${ [ .trigger.data.owner_id ] }",
              "category": "\u05d4\u05d5\u05d3\u05e2\u05d4",
              "title": "\u05e9\u05d0\u05dc\u05d4 \u05d7\u05d3\u05e9\u05d4 \u05de\u05dc\u05e7\u05d5\u05d7",
              "body": "\u05e9\u05d0\u05dc\u05d4 \u05e2\u05d1\u05d5\u05e8 ${ .trigger.data.zimmer_name }: ${ .trigger.data.question }",
              "action_type": "answer_question",
              "action_entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e9\u05dc\u05d7 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05dc\u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd"
          }
        }
      }
    ]
  }
}