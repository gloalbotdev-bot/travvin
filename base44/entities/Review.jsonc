{
  "type": "object",
  "properties": {
    "zimmer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e6\u05d9\u05de\u05e8"
    },
    "zimmer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e6\u05d9\u05de\u05e8"
    },
    "owner_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e2\u05dc \u05de\u05ea\u05d7\u05dd"
    },
    "booking_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "customer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7 \u05de\u05d1\u05e7\u05e8"
    },
    "customer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "guest_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d0\u05d5\u05e8\u05d7"
    },
    "check_in": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05db\u05e0\u05d9\u05e1\u05d4"
    },
    "check_out": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e6\u05d9\u05d0\u05d4"
    },
    "rating": {
      "type": "number",
      "title": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05db\u05dc\u05dc\u05d9 (1-5)"
    },
    "cat_match": {
      "type": "number",
      "title": "\u05d4\u05ea\u05d0\u05de\u05d4 \u05dc\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d5\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "cat_cleanliness": {
      "type": "number",
      "title": "\u05e0\u05d9\u05e7\u05d9\u05d5\u05df"
    },
    "cat_service": {
      "type": "number",
      "title": "\u05e9\u05d9\u05e8\u05d5\u05ea \u05d1\u05e2\u05dc \u05d4\u05de\u05e7\u05d5\u05dd"
    },
    "cat_location": {
      "type": "number",
      "title": "\u05de\u05d9\u05e7\u05d5\u05dd"
    },
    "cat_value": {
      "type": "number",
      "title": "\u05ea\u05de\u05d5\u05e8\u05d4 \u05dc\u05de\u05d7\u05d9\u05e8"
    },
    "text": {
      "type": "string",
      "title": "\u05ea\u05d5\u05db\u05df \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea"
    },
    "images": {
      "type": "array",
      "title": "\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05de\u05e6\u05d5\u05e8\u05e4\u05d5\u05ea",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_publish",
        "pending_owner",
        "compromise_offered",
        "published",
        "disputed",
        "removed"
      ],
      "default": "pending_publish",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "published_at": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05e8\u05e1\u05d5\u05dd"
    },
    "auto_publish_at": {
      "type": "string",
      "title": "\u05de\u05d5\u05e2\u05d3 \u05e4\u05e8\u05e1\u05d5\u05dd/\u05e4\u05e7\u05d9\u05e2\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9"
    },
    "reviewable_until": {
      "type": "string",
      "title": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05e2\u05d3"
    },
    "source": {
      "type": "string",
      "enum": [
        "\u05d9\u05d3\u05e0\u05d9",
        "Google",
        "Booking.com",
        "Airbnb",
        "WhatsApp"
      ],
      "title": "\u05de\u05e7\u05d5\u05e8",
      "default": "\u05d9\u05d3\u05e0\u05d9"
    },
    "review_date": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea"
    },
    "owner_response": {
      "type": "string",
      "title": "\u05ea\u05d2\u05d5\u05d1\u05ea \u05d1\u05e2\u05dc \u05d4\u05e6\u05d9\u05de\u05e8"
    },
    "owner_response_at": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05d2\u05d5\u05d1\u05ea \u05d1\u05e2\u05dc"
    },
    "dispute_reason": {
      "type": "string",
      "title": "\u05e1\u05d9\u05d1\u05ea \u05e2\u05e8\u05e8\u05d5\u05e8"
    },
    "disputed_at": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05e8\u05e8\u05d5\u05e8"
    },
    "settlement_offer": {
      "type": "object",
      "title": "\u05d4\u05e6\u05e2\u05ea \u05e4\u05e9\u05e8\u05d4",
      "properties": {
        "percentage": {
          "type": "number",
          "title": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05d7\u05d6\u05e8"
        },
        "amount": {
          "type": "number",
          "title": "\u05e1\u05db\u05d5\u05dd \u05d4\u05d7\u05d6\u05e8"
        },
        "owner_note": {
          "type": "string",
          "title": "\u05d4\u05e2\u05e8\u05ea \u05d1\u05e2\u05dc \u05d4\u05de\u05ea\u05d7\u05dd"
        },
        "customer_note": {
          "type": "string",
          "title": "\u05d4\u05e2\u05e8\u05ea \u05e1\u05d9\u05e8\u05d5\u05d1 \u05dc\u05e7\u05d5\u05d7"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "declined"
          ],
          "default": "pending",
          "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e4\u05e9\u05e8\u05d4"
        },
        "offered_at": {
          "type": "string",
          "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e6\u05e2\u05d4"
        },
        "resolved_at": {
          "type": "string",
          "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d2\u05d9\u05e8\u05d4"
        }
      }
    }
  },
  "required": [
    "zimmer_id",
    "owner_id",
    "rating"
  ],
  "name": "Review"
}